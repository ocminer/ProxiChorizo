# Example systemd unit for a headless Linux rig (not needed on HiveOS / mmpOS / SMOS).
# Install:  sudo cp examples/linux/proxichorizo.service /etc/systemd/system/
#           edit User, WorkingDirectory and the token/worker below, then:
#           sudo systemctl daemon-reload && sudo systemctl enable --now proxichorizo
# Logs:     journalctl -u proxichorizo -f        Stop: sudo systemctl stop proxichorizo
[Unit]
Description=ProxiChorizo Proxima miner (suprnova.cc)
After=network-online.target
Wants=network-online.target

[Service]
User=miner
WorkingDirectory=/home/miner/proxichorizo-2.0.6
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
# keep the token out of the unit: put it on the first line of pool.token (chmod 600)
ExecStart=/home/miner/proxichorizo-2.0.6/proxichorizo --proxi stratum+tcp://proxi.suprnova.cc:3355 --token-file pool.token --name rig1 --no-color --api-bind 127.0.0.1:4078
Restart=on-failure
RestartSec=30
# SIGINT stops the miner cleanly (it finishes the current launch and disconnects)
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
