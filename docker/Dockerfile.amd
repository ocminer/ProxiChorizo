# ProxiChorizo for AMD GPUs — the OpenCL miner plus AMD's ROCm OpenCL runtime, so the host needs only
# the amdgpu kernel driver (/dev/kfd, /dev/dri). The miner is built on Ubuntu 20.04 (glibc 2.31) exactly
# like the one in the Linux/HiveOS archives; the runtime image is Ubuntu 24.04 with ROCm's OpenCL ICD.
# ROCm 6.4 still covers Vega 20 (MI50/MI60, Radeon VII), CDNA, RDNA2, RDNA3 and RDNA4.
ARG ROCM_VERSION=6.4.3
FROM ubuntu:20.04 AS build
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      g++ make python3 ocl-icd-opencl-dev opencl-headers && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY proxichorizo.cu vectors.json ./
COPY opencl/ opencl/
RUN make -C opencl clean && make -C opencl proxichorizo-cl CL_INC=/usr/include CL_LIB=/usr/lib/x86_64-linux-gnu \
      CXXFLAGS="-O2 -std=c++17 -Wall -Wno-unused-function -I/usr/include -static-libstdc++ -static-libgcc" \
    && strip opencl/proxichorizo-cl

FROM ubuntu:24.04
ARG ROCM_VERSION
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://repo.radeon.com/rocm/rocm.gpg.key | gpg --dearmor -o /etc/apt/keyrings/rocm.gpg \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/rocm.gpg] https://repo.radeon.com/rocm/apt/${ROCM_VERSION} noble main" > /etc/apt/sources.list.d/rocm.list \
    && printf 'Package: *\nPin: origin repo.radeon.com\nPin-Priority: 600\n' > /etc/apt/preferences.d/rocm-pin-600 \
    && apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends rocm-opencl-runtime \
    && apt-get purge -y gnupg && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src/opencl/proxichorizo-cl /app/proxichorizo-cl
COPY docker/entrypoint.sh /app/entrypoint.sh
COPY README.md USAGE.md LICENSE NOTICE PLATFORMS.md vectors.json /app/
COPY benchmarks/ /app/benchmarks/
RUN chmod +x /app/entrypoint.sh /app/proxichorizo-cl
ENV PX_BIN=proxichorizo-cl PATH=/opt/rocm/bin:$PATH
EXPOSE 4078
ENTRYPOINT ["/app/entrypoint.sh"]
